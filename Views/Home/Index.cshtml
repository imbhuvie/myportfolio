<!-- ===================== PROJECTS ===================== -->
<section id="projects">
  <div class="container">
    <div class="eyebrow">05 — projects</div>
    <h2 class="sec-title">Something I've built</h2>

    @foreach (var project in Model.Projects)
    {
      <div class="project-card reveal">
        <div class="project-mock">
          <div class="browser-frame">
            <div class="browser-bar">
              <span class="dot"></span><span class="dot"></span><span class="dot"></span>
              <span class="url">@(project.Url ?? "portfolio.local/project")</span>
            </div>
            <div class="browser-body">
              <div class="mock-block b1"></div>
              <div class="mock-block b2"></div>
              <div class="mock-block b3"></div>
              <div class="mock-block b4"></div>
              <div class="mock-block b5"></div>
            </div>
          </div>
        </div>
        <div class="project-body">
          <div class="project-eyebrow">PROJECT</div>
          <h3 class="project-title">@project.Title</h3>
          <p class="project-desc">@project.Description</p>

          @if (!string.IsNullOrWhiteSpace(project.Problem))
          {
            <div class="project-issue">
              <div class="issue-label">// Problem</div>
              <p>@project.Problem</p>
            </div>
          }

          @if (!string.IsNullOrWhiteSpace(project.Solution))
          {
            <div class="project-issue solution">
              <div class="issue-label">// Solution</div>
              <p>@project.Solution</p>
            </div>
          }

          @if (!string.IsNullOrWhiteSpace(project.Features))
          {
            <ul class="project-features">
              @foreach (var feature in project.Features.Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
              {
                <li>@feature</li>
              }
            </ul>
          }

          @if (!string.IsNullOrWhiteSpace(project.TechStack))
          {
            <div class="project-stack">
              @foreach (var chip in project.TechStack.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
              {
                <span class="chip">@chip</span>
              }
            </div>
          }

          @if (!string.IsNullOrWhiteSpace(project.Url))
          {
            <div class="project-line">
              <a class="btn btn-outline" href="@project.Url" target="_blank" rel="noopener">Visit Project ↗</a>
            </div>
          }
        </div>
      </div>
    }

    @if (!Model.Projects.Any())
    {
      <div class="more-soon reveal">// more projects pushing to main soon — check back later 👀</div>
    }
  </div>
</section>

