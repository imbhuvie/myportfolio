@model PortfolioApp.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Admin Login";
}

<div class="admin-login">
  <div class="admin-form">
    <h2 class="admin-title">Admin Login</h2>
    <p class="admin-sub">Enter the admin password to manage projects.</p>

    <form asp-controller="Account" asp-action="Login" method="post" style="margin-top:22px;">
      <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

      <div class="form-group">
        <label asp-for="Password" class="form-label"></label>
        <input asp-for="Password" class="form-input" type="password" autofocus />
        <span asp-validation-for="Password" class="field-validation-error"></span>
      </div>

      <button type="submit" class="btn btn-primary" style="width:100%; justify-content:center;">Login</button>
    </form>
  </div>
</div>
